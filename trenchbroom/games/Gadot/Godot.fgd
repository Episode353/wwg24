    edge_size(float) : "Edge Size" : 2.0 : "Foam edge width"
    edge_intensity(float) : "Edge Intensity" : 2.0 : "Foam edge intensity"
    ripple_intensity(float) : "Ripple Intensity" : 0.6 : "Small ripple amount"
]


