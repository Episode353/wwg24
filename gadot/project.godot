[physics]

common/max_physics_steps_per_frame=60
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=120
jolt_physics_3d/simulation/position_steps=120
jolt_physics_3d/simulation/areas_detect_static_bodies=true
common/physics_interpolation=true
jolt_3d/collisions/areas_detect_static_bodies=true
jolt_3d/collisions/report_all_kinematic_contacts=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=512
lights_and_shadows/directional_shadow/size.mobile=512
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
shading/overrides/force_vertex_shading=true
textures/default_filters/anisotropic_filtering_level=0
environment/ssao/quality=0
environment/ssil/quality=0
environment/glow/upscale_mode=0
environment/volumetric_fog/use_filter=0
