]

@PointClass size(-8 -8 -8, 8 8 8) color(255 0 255) = bot_spawn : "Enemy Bot Spawn" [
    use_spawn_position(bool) : "Use Spawn Position" : 1 : "If 1, Bot Respawns at position of entity placment in trenchbroom; if 0, it spawns at a regular spawnpoint."
    disable_respawn(bool) : "Use Spawn Position" : 1 : "If 1, the bot will not resapwn; if 0, the bot will respawn"
    weapon(string) : "What weapon the Bot Starts With. (ak47, knife, rocket_launcher, shotgun, hegrenade, salsa, keyboard or hands" : "rocket_launcher"
    weapon_range(string) : "Use Spawn Position" : 25 : "How far in meters an enemy must be for the bot to shoot. The Bot will not fire at enimies further than this distance"
]

@PointClass size(-8 -8 -8, 8 8 8) color(0 255 0) = world_label_label_3d : "Label 3D" [
    text(string) : "Label text" : "Example Text"
    billboard(string) : "Billboard Rendering" : 0 : "0: Disabled, 1: Enabled, 2: Y-Billboard"
    pixel_size(float) : "Size of a pixel of text" : 0.005
    font_size(string) : "Size the font is rendered" : 45
    outline_size(integer) : "Text outline size" : 12 : "Thickness of the text outline in pixels, 0 disables the outline"
    text_color(color255) : "Color" : "255 255 255" : "R,G,B"
    double_sided(bool) : "Double sided" : 1 : "If 1, Text visible on both sides; if 0, text only visible on one side"
]

